{
  "$defs": {
    "Query": {
      "additionalProperties": false,
      "properties": {
        "cause": {
          "title": "Cause",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "question_type": {
          "enum": [
            "reachability",
            "effect_direction",
            "effect_magnitude",
            "intervention_probability",
            "adjustment_validity"
          ],
          "title": "Question Type",
          "type": "string"
        },
        "from_value": {
          "default": 0,
          "enum": [
            0,
            1
          ],
          "title": "From Value",
          "type": "integer"
        },
        "to_value": {
          "default": 1,
          "enum": [
            0,
            1
          ],
          "title": "To Value",
          "type": "integer"
        },
        "intervention_value": {
          "default": 1,
          "enum": [
            0,
            1
          ],
          "title": "Intervention Value",
          "type": "integer"
        },
        "adjustment_set": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Adjustment Set",
          "type": "array"
        }
      },
      "required": [
        "cause",
        "outcome",
        "question_type"
      ],
      "title": "Query",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "query": {
      "$ref": "#/$defs/Query"
    },
    "requested_operation": {
      "enum": [
        "has_directed_path",
        "compute_effect",
        "compute_intervention",
        "is_valid_adjustment_set",
        "backdoor_adjustment"
      ],
      "title": "Requested Operation",
      "type": "string"
    },
    "proposed_tool": {
      "enum": [
        "has_directed_path",
        "compute_effect",
        "compute_intervention",
        "is_valid_adjustment_set",
        "backdoor_adjustment"
      ],
      "title": "Proposed Tool",
      "type": "string"
    },
    "proposed_answer": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "enum": [
            "positive",
            "negative",
            "zero"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposed Answer"
    },
    "response_action": {
      "default": "answer",
      "enum": [
        "answer",
        "abstain"
      ],
      "title": "Response Action",
      "type": "string"
    }
  },
  "required": [
    "query",
    "requested_operation",
    "proposed_tool"
  ],
  "title": "Proposal",
  "type": "object"
}
