{
  "$defs": {
    "Query": {
      "additionalProperties": false,
      "properties": {
        "cause": {
          "title": "Cause",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "question_type": {
          "enum": [
            "reachability",
            "effect_direction",
            "effect_magnitude",
            "intervention_probability",
            "adjustment_validity"
          ],
          "title": "Question Type",
          "type": "string"
        },
        "from_value": {
          "default": 0,
          "enum": [
            0,
            1
          ],
          "title": "From Value",
          "type": "integer"
        },
        "to_value": {
          "default": 1,
          "enum": [
            0,
            1
          ],
          "title": "To Value",
          "type": "integer"
        },
        "intervention_value": {
          "default": 1,
          "enum": [
            0,
            1
          ],
          "title": "Intervention Value",
          "type": "integer"
        },
        "adjustment_set": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Adjustment Set",
          "type": "array"
        }
      },
      "required": [
        "cause",
        "outcome",
        "question_type"
      ],
      "title": "Query",
      "type": "object"
    },
    "ToolRequest": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "has_directed_path",
            "compute_effect",
            "compute_intervention",
            "is_valid_adjustment_set",
            "backdoor_adjustment"
          ],
          "title": "Operation",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/Query"
        },
        "evidence_digest": {
          "title": "Evidence Digest",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "query",
        "evidence_digest"
      ],
      "title": "ToolRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request": {
      "$ref": "#/$defs/ToolRequest"
    },
    "value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "request"
  ],
  "title": "ToolResult",
  "type": "object"
}
